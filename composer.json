{
    "name": "vncoder/framework",
    "description": "VnCoder framework base from lumen",
    "keywords": ["framework", "vncoder", "lumen"],
    "license": "MIT",
    "homepage": "https://nhatky.date",
    "authors": [
        {"name": "Nam Pham", "email": "vncoder@gmail.com"}
    ],
    "require": {
        "php": "^8.2",
        "laravel/lumen-framework": "^v11.2.0",
        "illuminate/session": "^11.45.0",
        "intervention/image": "^3.11.0",
        "php-debugbar/php-debugbar": "^2.1",
        "zircote/swagger-php": "^5.1.0"
    },
    "autoload": {
        "psr-4": {
            "VnCoder\\": "src/",
            "Barryvdh\\Debugbar\\": "debugbar/"
        },
        "files": [
            "helper/common.php",
            "helper/helper.php",
            "helper/debugbar.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
